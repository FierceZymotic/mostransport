# Copy to .env and fill in before `docker compose up`.

# Baked into the frontend build (Vite). Do not commit the real value.
VITE_YANDEX_MAPS_API_KEY=your_yandex_maps_js_api_key

# Host path with a generated ML Artifact Bundle (see docs/DOCKER_COMPOSE.md
# for how to produce the integration-only artifact). Mounted read-only into
# the ml service at /artifact.
ML_ARTIFACT_DIR=./ml-artifact
