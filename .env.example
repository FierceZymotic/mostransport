# Copy to .env and fill in before `docker compose up`.

# Baked into the frontend build (Vite). Do not commit the real value.
VITE_YANDEX_MAPS_API_KEY=your_yandex_maps_js_api_key

# Host path with the ML Artifact Bundle, mounted read-only at /artifact.
# Default: the final model hgb-h0-runtime-safe-v1-group-a-v1 (git-ignored; see
# docs/DOCKER_COMPOSE.md). ./ml-artifact is the INTEGRATION-ONLY fixture.
ML_ARTIFACT_DIR=./artifacts/hgb-h0-runtime-safe-v1-group-a-v1

# Backend demo clock: one constant offset for the whole session (intervals kept).
# day_shift = live wall-clock telemetry lands on DEMO_CLOCK_TARGET_DAY (emulator demo);
# off = times used unchanged (replay of organizer data already on the schedule day);
# translate = session start mapped onto DEMO_CLOCK_ANCHOR (ISO-8601 with zone).
DEMO_CLOCK_MODE=day_shift
DEMO_CLOCK_TARGET_DAY=2026-01-06
# DEMO_CLOCK_ANCHOR=2026-01-06T03:20:00Z

# Source of factual passage times for current_deviation_seconds (backend):
# none = no runtime source exists -> 0 with an explicit degraded marker;
# replay_import = TRAIN-day facts imported by scripts/import_db_seed.py --replay-facts.
SCHEDULE_FACT_SOURCE=none

# Backend database connection used by Prisma/Postgres in compose.
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/mostransport?schema=public
