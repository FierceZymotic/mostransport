generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}
datasource db {
  provider = "postgresql"
}

model predictions {
  request_id             String    @id @db.VarChar(64)
  unit_id                String    @db.VarChar(64)
  tr_id                  String?   @db.VarChar(64)
  prediction_time        DateTime  @db.Timestamptz(6)
  target_action_id       String?   @db.VarChar(64)
  target_time_begin      DateTime? @db.Timestamptz(6)
  status                 String    @db.VarChar(32)
  delay_seconds          Float?
  target_time            DateTime? @db.Timestamptz(6)
  reason                 String?
  generated_at           DateTime  @default(now()) @db.Timestamptz(6)
  model_version          String?   @db.VarChar(64)
  feature_schema_version String?   @db.VarChar(64)

  @@index([target_action_id], map: "idx_predictions_target_action")
  @@index([unit_id, prediction_time(sort: Desc)], map: "idx_predictions_unit_time")
}

model schedule_actions {
  tt_action_item_id String                  @id @db.VarChar(64)
  tr_id             String                  @db.VarChar(64)
  time_begin        DateTime                @db.Timestamptz(6)
  geom              Unsupported("geometry")
  manual_fill       Json?

  @@index([tr_id, time_begin], map: "idx_schedule_tr_time")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}

model telemetry {
  id             BigInt   @id @default(autoincrement())
  unit_id        String   @db.VarChar(64)
  tr_id          String?  @db.VarChar(64)
  timestamp      DateTime @db.Timestamptz(6)
  longitude      Float
  latitude       Float
  location_valid Boolean  @default(false)
  speed          Float?
  speed_max      Float?
  course         Float?
  track          Float?
  altitude       Float?
  nsat           Int?
  pdop           Float?

  @@index([timestamp], map: "idx_telemetry_time")
  @@index([unit_id, timestamp(sort: Desc)], map: "idx_telemetry_unit_time")
}

model vehicle_last_state {
  unit_id        String   @id @db.VarChar(64)
  tr_id          String?  @db.VarChar(64)
  timestamp      DateTime @db.Timestamptz(6)
  longitude      Float?
  latitude       Float?
  speed          Float?
  location_valid Boolean?
}

model vehicles {
  unit_id       String  @id @db.VarChar(64)
  current_tr_id String? @db.VarChar(64)
}
