# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# --- Virtual environment ---
.venv/
venv/

# --- Tooling caches ---
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- Notebooks ---
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# --- Environment / secrets ---
.env
.env.*
!.env.example

# --- Organizer / confidential data: never commit ---
# Keep the directories and their README/.gitkeep, ignore everything inside.
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep

# --- Generated experiment logs and model artifacts ---
experiments/*.jsonl
experiments/*.log
*.pkl
*.joblib
*.cbm
# Root-level Artifact Bundle output (anchored: must NOT match the source
# package src/mostransport_ml/artifacts/).
/artifacts/
# Generated submissions.
submission*.csv

# --- JS tooling (Backend/Frontend will live in this repository) ---
node_modules/

# --- OS / IDE ---
.DS_Store
.idea/
# Windows alternate data streams copied into WSL.
*:Zone.Identifier

# Local AI-agent instructions
/AGENTS.md
/CLAUDE.md
